{
  "mcpServers": {
    "godot": {
      "command": "npx",
      "args": ["-y", "godot-mcp-server@0.6.1"]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "replicate": {
      "command": "scripts/replicate-mcp.sh",
      "args": []
    },
    "bot-trainer": {
      "type": "http",
      "url": "${BOT_TRAINER_URL}",
      "headers": {
        "Authorization": "Bearer ${BOT_TRAINER_TOKEN}"
      }
    }
  }
}
