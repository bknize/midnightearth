# Copy to .env and fill in. .env is gitignored; never commit it and never paste tokens in chat.
# scripts/claude-with-env.sh sources this before launching Claude Code so .mcp.json can
# expand the ${VAR} placeholders.

# Replicate API token (https://replicate.com/account/api-tokens) for the replicate MCP
# server. Art generation is billed to Replicate, not to Claude (decision D3).
REPLICATE_API_TOKEN=

# Optional: path to the Godot 4.6 binary when it is not at /Applications/Godot 4.6.app.
# GODOT_BIN=/Applications/Godot 4.6.app/Contents/MacOS/Godot
