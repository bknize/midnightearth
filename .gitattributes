# Approved art is stored with Git LFS (ADR 0003). Candidates under art/candidates/ are
# gitignored and never reach LFS.
godot/art/**/*.png filter=lfs diff=lfs merge=lfs -text
godot/art/**/*.webp filter=lfs diff=lfs merge=lfs -text
godot/art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# The bot stamp hashes these files' raw bytes (cycle 11 R1): never convert line endings,
# so a Windows checkout gives the same stamp as the Mac.
godot/engine/data/*.json -text
godot/tests/fixtures/stamp/*.json -text
